# Copy to .env and fill in. NEVER commit .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Local AI (free, default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional free-tier OpenAI-compatible adapter (leave empty to disable)
FREE_API_URL=
FREE_API_KEY=
FREE_API_MODEL=
# Scanner binaries (defaults assume they are on PATH)
SEMGREP_BIN=semgrep
GITLEAKS_BIN=gitleaks
DEPCHECK_BIN=dependency-check.sh
WORKDIR=./workdir
REPORT_DIR=./reports
SCAN_TIMEOUT_SECONDS=600
SEMGREP_CONFIG=p/default   # "auto" needs metrics enabled, so a registry pack is used
# Optional but strongly recommended: free NVD API key makes Dependency-Check DB download far faster
NVD_API_KEY=
